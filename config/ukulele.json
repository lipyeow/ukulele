// Shared ChordPro config for all song sheets.
{
  "include": [ "ukulele" ],
  // The ukulele chord set has no sus4 chords; the sources' "sus" is sus4 (see
  // scripts/txt2cho.py), so define them here, for every root a transposed song can hit.
  "chords": [
    // The familiar Em (one open string) instead of ChordPro's 0 4 0 2.
    { "name": "Em", "base": 1, "frets": [ 0, 4, 3, 2 ] },
    { "name": "Csus4", "base": 1, "frets": [ 0, 0, 1, 3 ] },
    { "name": "C#sus4", "base": 1, "frets": [ 1, 1, 2, 4 ] },
    { "name": "Dbsus4", "base": 1, "frets": [ 1, 1, 2, 4 ] },
    { "name": "Dsus4", "base": 1, "frets": [ 0, 2, 3, 0 ] },
    { "name": "D#sus4", "base": 1, "frets": [ 1, 3, 4, 1 ] },
    { "name": "Ebsus4", "base": 1, "frets": [ 1, 3, 4, 1 ] },
    { "name": "Esus4", "base": 1, "frets": [ 4, 4, 0, 0 ] },
    { "name": "Fsus4", "base": 1, "frets": [ 3, 0, 1, 1 ] },
    { "name": "F#sus4", "base": 1, "frets": [ 4, 1, 2, 2 ] },
    { "name": "Gbsus4", "base": 1, "frets": [ 4, 1, 2, 2 ] },
    { "name": "Gsus4", "base": 1, "frets": [ 0, 2, 3, 3 ] },
    { "name": "G#sus4", "base": 1, "frets": [ 1, 3, 4, 4 ] },
    { "name": "Absus4", "base": 1, "frets": [ 1, 3, 4, 4 ] },
    { "name": "Asus4", "base": 1, "frets": [ 2, 2, 0, 0 ] },
    { "name": "A#sus4", "base": 1, "frets": [ 3, 3, 1, 1 ] },
    { "name": "Bbsus4", "base": 1, "frets": [ 3, 3, 1, 1 ] },
    { "name": "Bsus4", "base": 1, "frets": [ 4, 4, 2, 2 ] }
  ],
  // [<off>D</off>]: a chord off the usual beat, printed plain grey instead of bold black.
  // It still transposes and gets its diagram (see wiki/style-guide.md).
  "markup": { "shortcodes": { "off": "font_weight='normal' color='grey50'" } },
  "pdf": {
    "papersize": "letter",
    // Where a chord is wider than the text under it, fill the gap with hyphens, hymnal style
    // (Is - - ra-el): the singer holds that syllable while the chord or beat changes.
    "split-marker": [ "", "-", "" ],
    // Print the full chorus every time it is recalled, for easy play-along.
    "chorus": { "recall": { "quote": true } },
    // Fixed-width fonts in config/fonts (with their licences). The scripts run ChordPro from
    // the repo root, so this path resolves. To switch, change "inconsolata" to "ubuntumono"
    // in "fonts" below. Both are 0.5 em wide, so the label width below fits either.
    "fontdir": [ "config/fonts" ],
    "fontconfig": {
      "inconsolata": { "": "Inconsolata-Regular.ttf", "bold": "Inconsolata-Bold.ttf" },
      "ubuntumono": { "": "UbuntuMono-Regular.ttf", "bold": "UbuntuMono-Bold.ttf" }
    },
    "fonts": {
      "title": "Times-Bold 18",
      "subtitle": "Helvetica 11",
      "text": "inconsolata 11",
      "chord": "inconsolata bold 10",
      // Not used by our songs, but ChordPro loads it anyway; keep Courier out of the PDFs.
      "tab": "inconsolata 10",
      "comment": "Helvetica 11; background=foreground-light"
    },
    "formats": {
      "title": {
        "title": [ "%{title}", "", "" ],
        "subtitle": [ "Key: %{key_actual}%{time|   Time: %{}}", "", "" ],
        "footer": [ "", "", "%{page}" ]
      },
      "default": {
        "footer": [ "%{title} (%{key_actual})", "", "%{page}" ]
      }
    },
    "diagrams": { "show": "top" },
    // Verse numbers one space from the lyrics: "1" plus a space, 2 x 5.5 pt at 11 pt.
    "labels": { "width": 11 }
  }
}
