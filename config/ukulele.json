// Shared ChordPro config for all song sheets.
{
  "include": [ "ukulele" ],
  "pdf": {
    "papersize": "letter",
    // Where a chord is wider than the text under it, fill the gap with underscores: the
    // singer is holding that syllable while the chord or beat changes (hymnal extender).
    "split-marker": [ "", "_", "" ],
    // Print the full chorus every time it is recalled, for easy play-along.
    "chorus": { "recall": { "quote": true } },
    "fonts": {
      "title": "Times-Bold 18",
      "subtitle": "Helvetica 11",
      "text": "Times-Roman 12",
      "chord": "Helvetica-Bold 10",
      "comment": "Helvetica 11; background=foreground-light"
    },
    "formats": {
      "title": {
        "title": [ "%{title}", "", "" ],
        "subtitle": [ "Key: %{key_actual}%{time|   Time: %{}}", "", "" ],
        "footer": [ "", "", "%{page}" ]
      },
      "default": {
        "footer": [ "%{title} (%{key_actual})", "", "%{page}" ]
      }
    },
    "diagrams": { "show": "top" }
  }
}
