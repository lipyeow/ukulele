{title: God of the Sparrow}
{key: C}
{time: 3/4}
{columns: 2}

{start_of_verse: 1}
[C]God of the [Em]sparrow
[Am]God of the [Dm]whale
[G]God of the [C]swirling [F]sta[E7]-rs
[Am]How does the [Em]creature say [Dm]Awe[C]-
[Am]How does the [Dm]creature say [C]Praise[G]
{end_of_verse}

{start_of_verse: 2}
[C]God of the [Em]earthquake
[Am]God of the [Dm]storm
[G]God of the [C]trumpet [F]bla[E7]-st
[Am]How does the [Em]creature cry [Dm]Woe[C]-
[Am]How does the [Dm]creature cry [C]Save[G]
{end_of_verse}

{start_of_verse: 3}
[C]God of the [Em]rainbow
[Am]God of the [Dm]cross
[G]God of the [C]empty [F]gra[E7]-ve
[Am]How does the [Em]creature say [Dm]Gra[C]-ce
[Am]How does the [Dm]creature say [C]Thanks[G]
{end_of_verse}

{start_of_verse: 4}
[C]God of the [Em]hungry
[Am]God of the [Dm]sick
[G]God of the [C]prodi[F]ga[E7]-l
[Am]How does the [Em]creature say [Dm]Care[C]-
[Am]How does the [Dm]creature say [C]Life[G]
{end_of_verse}

{start_of_verse: 5}
[C]God of the [Em]neighbour
[Am]God of the [Dm]foe
[G]God of the [C]pruning [F]hoo[E7]-k
[Am]How does the [Em]creature say [Dm]Lo[C]-ve
[Am]How does the [Dm]creature say [C]Peace[G]
{end_of_verse}

{start_of_verse: 6}
[C]God of the [Em]ages
[Am]God near at [Dm]hand
[G]God of the [C]loving [F]hea[E7]-rt
[Am]How do your [Em]children say [Dm]Joy[C]-
[Am]How do your [Dm]children say [C]Home[G]
{end_of_verse}
